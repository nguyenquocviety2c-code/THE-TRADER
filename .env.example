# The Trader — cấu hình môi trường (nhân bản thành .env rồi điền giá trị)

# CSDL SQLite (Prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Giai đoạn 2 ────────────────────────────────────────────────
# S3 — Giao dịch thật VNDIRECT (mặc định TẮT: mọi Order là paper).
# Bật = true yêu cầu thêm 2 biến bên dưới; thiếu → API từ chối + audit log.
LIVE_TRADING=false
# VNDIRECT_API_BASE=https://api.vndirect.com.vn
# VNDIRECT_API_TOKEN=<token khách hàng VNDIRECT open API>

# S4 — true: engine chỉ sinh tick giá trong phiên HOSE (09:15–11:30 /
# 13:00–14:45, T2–T6, đã bỏ qua nghỉ lễ VN); false: demo 24/7 (đã gắn nhãn mô phỏng)
MARKET_STRICT_SESSION=false

# ── mini-services/market-engine (port 3003) ────────────────────
# TICK_MS=10000            # nhịp tick bảng giá (ms)
# NEWS_MS=900000           # chu kỳ nạp RSS (ms, mặc định 15 phút)
# AGENT_CYCLE_MINUTES=0    # chu kỳ agent tự động (0 = tắt, tiết kiệm LLM)
# APP_URL=http://localhost:3000
